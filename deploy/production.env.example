# Copy to backend/.env ON THE UBUNTU SERVER; do not replace your local config.
BIND_IP=0.0.0.0
# Discover with docker inspect elastalert2 (see docs/ubuntu-production.md).
ELK_NETWORK=REPLACE_WITH_ELK_DOCKER_NETWORK
RELEASE_TAG=local
# Generate a hex password and use the same value in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://ai_notify:REPLACE_WITH_RANDOM_HEX@postgres:5432/ai_notify
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
APP_ORIGIN=https://app.example.com
COOKIE_SECURE=true
OLLAMA_URL=https://ollama.example.com/api/generate
OLLAMA_MODEL=llama3.1:8b
TEAMS_WEBHOOK_URL=REPLACE_WITH_TEAMS_WEBHOOK
# Empty disables discovery until networks are explicitly allowed.
DISCOVERY_ALLOWED_CIDRS=
